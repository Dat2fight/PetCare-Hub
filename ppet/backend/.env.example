# Documentation only: Spring Boot does not automatically load .env.
# Provide these values through your terminal, IDE, or secret manager.
JWT_SECRET=
DB_USERNAME=
DB_PASSWORD=
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=petcarehub;encrypt=true;trustServerCertificate=true
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_COM_PETCAREHUB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
# Optional one-time admin bootstrap. Disable after first successful startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

APP_BOOKING_TIMEZONE=Asia/Ho_Chi_Minh

APP_BOOKING_LOCKTIMEOUTMS=5000
APP_BOOKING_CANCELLATIONNOTICEHOURS=2

# Flyway: see docs/migrations.md; onboarding is a one-time, reviewed operation.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# Optional integration tests only (tools/test-sqlserver.ps1 sets/restores these).
# These do not change the application's datasource.
RUN_SQLSERVER_TESTS=false
SQLSERVER_TEST_MODE=local
SQLSERVER_TEST_ALLOW_CREATE=false
SQLSERVER_TEST_PORT=1433
# Leave both blank for Windows Authentication with the Microsoft JDBC auth DLL.
SQLSERVER_TEST_USERNAME=
SQLSERVER_TEST_PASSWORD=

# Admin foundation: no new secrets/settings. V16/V17 required before running this version.
# Existing JWTs without tv are rejected; users must log in again.
# Do not enable bootstrap against an existing production account to reset its credentials.

# Admin operations: V18 required; no new environment variables. Cash/refunds are recorded manually.
# Run integration tests only with tools/test-sqlserver.ps1 against disposable test databases.

# Admin catalog: V19 required. HTTPS image host allowlist; server never downloads images.
APP_CATALOG_IMAGE_HOSTS=images.unsplash.com,images.pexels.com
# Existing APP_BUSINESS_ZONE/booking defaults still govern dates and fallback hours.

# Admin insights: V20 required. Web notifications only; no SMTP or gateway credentials.
APP_NOTIFICATIONS_ENABLED=true
APP_NOTIFICATIONS_INTERVAL_MS=5000
APP_NOTIFICATIONS_INITIAL_DELAY_MS=30000
APP_REMINDERS_ENABLED=true
APP_REMINDERS_INTERVAL_MS=3600000
APP_REMINDERS_INITIAL_DELAY_MS=60000
# Positive intervals only. Dispatch: <=100 recipients/tick; reminders: <=100 of each kind/tick.
# Appointment horizon 24 hours; vaccination horizon 7 days. Disable corresponding reserved
# template or APP_REMINDERS_ENABLED to suspend automatic reminders without deleting receipts.
