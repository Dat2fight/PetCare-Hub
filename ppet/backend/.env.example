# Documentation only: Spring Boot does not automatically load this file or .env.
# Supply JWT_SECRET through the process environment / IDE launcher / secret store.
# Generate 64 random bytes and encode as Base64; minimum accepted: 32 UTF-8 bytes.
# CHANGE_ME is deliberately rejected at startup. Never put this secret in VITE_*.
JWT_SECRET=CHANGE_ME
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=petcarehub;encrypt=true;trustServerCertificate=true
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_COM_PETCAREHUB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
# Java demo catalog seed runs under dev only when species is empty; no separate seed flag.
# Optional admin creation: explicitly enable, supply all fields, then disable after first run.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
