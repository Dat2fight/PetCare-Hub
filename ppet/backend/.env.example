# Documentation only: Spring Boot does not automatically load .env.
# Provide these values through your terminal, IDE, or secret manager.
JWT_SECRET=
DB_USERNAME=
DB_PASSWORD=
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=petcarehub;encrypt=true;trustServerCertificate=true
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_COM_PETCAREHUB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
# Optional one-time admin bootstrap. Disable after first successful startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
