# Documentation only: Spring Boot does not automatically load .env.
# Provide these values through your terminal, IDE, or secret manager.
JWT_SECRET=
DB_USERNAME=
DB_PASSWORD=
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=petcarehub;encrypt=true;trustServerCertificate=true
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_COM_PETCAREHUB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
# Optional one-time admin bootstrap. Disable after first successful startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

APP_BOOKING_TIMEZONE=Asia/Ho_Chi_Minh

APP_BOOKING_LOCKTIMEOUTMS=5000
APP_BOOKING_CANCELLATIONNOTICEHOURS=2

# Flyway: see docs/migrations.md; onboarding is a one-time, reviewed operation.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# Optional integration tests only (tools/test-sqlserver.ps1 sets/restores these).
# These do not change the application's datasource.
RUN_SQLSERVER_TESTS=false
SQLSERVER_TEST_MODE=local
SQLSERVER_TEST_ALLOW_CREATE=false
SQLSERVER_TEST_PORT=1433
# Leave both blank for Windows Authentication with the Microsoft JDBC auth DLL.
SQLSERVER_TEST_USERNAME=
SQLSERVER_TEST_PASSWORD=
