# Public build-time URLs. Local Vite proxies these paths to localhost:8081.
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws
# For deployment, replace with your HTTPS API (/api/v1) and SockJS (/ws) URLs.
# SockJS uses https://, not wss://. Never put credentials or JWT_SECRET in VITE_*.

VITE_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

VITE_SITE_HOTLINE=
VITE_SITE_ADDRESS=
VITE_SITE_EMAIL=
VITE_SITE_HOURS=

# Admin portal uses the same VITE_API_BASE_URL; backend V16/V17 required.
# No staff passwords or admin credentials belong in VITE_* variables.

# Admin operations require backend V18. Existing API base URL and business timezone apply.
# No payment gateway, mail provider or social login configuration is needed.
